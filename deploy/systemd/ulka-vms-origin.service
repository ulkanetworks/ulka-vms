[Unit]
Description=Ulka VMS origin (video segments from storage)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=ulka-vms
WorkingDirectory=/opt/ulka-vms
# The settings are read by sh, not systemd, so values like ${POSTGRES_PASSWORD} inside others expand.
ExecStart=/bin/sh -c 'set -a; . /etc/ulka-vms/ulka-vms.env; set +a; exec /opt/ulka-vms/bin/ulka-vms origin'
Restart=always
RestartSec=5
TimeoutStopSec=40
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
