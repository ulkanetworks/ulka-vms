# Public origin. Serves encrypted segments and init segments only; playlists, keys and sources go through the API.
# Filled in by the nginx image's envsubst: S3_PUBLIC_URL, the bucket's address for reads without a key (README, Deployment).
# One JSON object per request; Vector ships these to ClickHouse, where video delivery is metered.
# One access log file per day; Vector deletes each once it has shipped it (remove_after_secs), so logs never pile up.
map $time_iso8601 $log_day { "~^(?<d>\d{4}-\d{2}-\d{2})" $d; default "undated"; }

log_format ulka_json escape=json '{"ts":"$time_iso8601","client_addr":"$remote_addr","method":"$request_method",'
    '"uri":"$request_uri","status":$status,"body_bytes":$body_bytes_sent,"request_time":$request_time,'
    '"user_agent":"$http_user_agent","referer":"$http_referer"}';

server {
    root /usr/share/nginx/html; # nginx checks a root exists before writing a log whose path has a variable
    listen 80;
    resolver 127.0.0.11 valid=60s; # Docker's DNS; a variable in proxy_pass resolves per request, so a provider's IPs may move

    location ~ "^/s/([0-9a-f-]{36}/[0-9a-f-]{36}/(?:[0-9]+p|audio)/(?:init\.mp4|[0-9]+\.m4s))$" {
        limit_except GET { deny all; }
        proxy_pass ${S3_PUBLIC_URL}/$1;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_max_temp_file_size 0; # stream segments through; never spool them to disk
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        # Storage adds its own CORS headers when a request has an Origin; two Access-Control-Allow-Origin
        # values make browsers refuse every segment. Only the origin's own headers below go out.
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Expose-Headers;
        proxy_hide_header Vary;
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header Set-Cookie;
        proxy_intercept_errors on;
        error_page 403 404 =404 /missing;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age=31536000" always;
        access_log /var/log/ulka/origin-$log_day.json ulka_json;
    }

    location = /missing { internal; return 404; }
    location / { return 404; }
}
