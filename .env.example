# Copy to .env and fill in the blanks. Secrets: openssl rand -base64 24 (SEAL_KEY: openssl rand -base64 32).

# Database
POSTGRES_DB=ulka_vms
POSTGRES_PASSWORD=
ULKA_APP_PASSWORD=
MIGRATE_DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@localhost:5434/${POSTGRES_DB}
DATABASE_URL=postgres://ulka_app:${ULKA_APP_PASSWORD}@localhost:5434/${POSTGRES_DB}

# API and addresses
API_ADDR=127.0.0.1:8096
# Where `ulka-vms origin` listens: it serves video segments from storage at ORIGIN_URL
ORIGIN_ADDR=127.0.0.1:8092
PUBLIC_URL=http://localhost:5173
ORIGIN_URL=http://localhost:8092/s
PLAYER_URL=http://localhost:5173
# Where the guides and the API reference are read; in development the console's own address
DOCS_URL=http://localhost:5173
# The player host's home shows this video: none, or <library id>/<video id> (a public one)
PLAYER_DEMO=none
# Whether anyone may create a workspace: open, or closed (only invites bring people in)
SIGNUP=open
# Proxies whose X-Forwarded-For names the caller: none, or addresses and ranges
TRUSTED_PROXIES=127.0.0.1,::1
# Optional: an IP-to-country database (MaxMind format) for libraries' country rules
GEOIP_DB=

# Worker
WORKER_QUEUES=interactive=4,standard=2,webhooks=20,maintenance=2
WORKER_ENCODE_SLOTS=auto

# Storage: any S3-compatible store (AWS S3, Cloudflare R2, Backblaze B2, Wasabi, MinIO…), with a private bucket and
# a key that may read, write and delete in it. These values are development's local stand-in (compose.dev.yaml).
S3_ENDPOINT=http://localhost:8334
S3_REGION=us-east-1
S3_BUCKET=ulka-vms
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
COMPOSE_FILE=compose.yaml:compose.dev.yaml

# Email: resend, smtp or log (development: emails are only logged)
MAIL_PROVIDER=log
MAIL_FROM="Videos <hello@localhost.test>"
MAIL_FALLBACK=
RESEND_API_KEY=
SMTP_URL=

# Video keys: local (sealed in the database, served by the player host) or securedrm, Ulka Networks' hosted key
# service, which keeps keys off this server (SECUREDRM_* are the credentials it issues; see SELF-HOSTING.md)
KEY_SERVICE=local
SECUREDRM_URL=
SECUREDRM_API_KEY=
SECUREDRM_TOKEN_KID=
SECUREDRM_TOKEN_SECRET=

# Secrets: never change SEAL_KEY once there is data; it seals video keys and other secrets
SEAL_KEY=

# ClickHouse and telemetry
CLICKHOUSE_PASSWORD=
CLICKHOUSE_URL=http://ulka:${CLICKHOUSE_PASSWORD}@localhost:8124/
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Tests
TEST_DATABASE_URL=postgres://ulka_app:${ULKA_APP_PASSWORD}@localhost:5434/ulka_vms_test
TEST_OWNER_DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@localhost:5434/ulka_vms_test
TEST_CLICKHOUSE_URL=${CLICKHOUSE_URL}?database=ulka_vms_test
